# ---- Language model (conversation + eval simulator + judge) ----
# Get one at https://platform.claude.com -> Settings -> API keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the live conversation. Chosen by eval, not by default.
AGENT_MODEL=claude-haiku-5-5
# Model that plays the customer in scripted eval scenarios.
SIMULATOR_MODEL=claude-sonnet-5-5
# Model that scores transcripts against the rubric.
JUDGE_MODEL=claude-opus-5-5

# ---- Speech (voice mode only) ----
# Deepgram covers both STT (Nova-3) and TTS (Aura-2) on one key.
# Get one at https://console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=

# ---- Realtime transport (voice mode only) ----
# Free project at https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Outcome delivery ----
# Stands in for the CRM. Grab a throwaway URL at https://webhook.site
OUTCOME_WEBHOOK_URL=

# ---- Issuer configuration ----
# The agent is issuer-agnostic; these drive what it says on a call.
ISSUER_NAME=Mumbai Bank
ISSUER_HELPLINE=1800-123-4567
